{
  "name": "korrektur-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @korrektur/api dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @korrektur/api db:generate",
    "db:seed": "pnpm --filter @korrektur/api db:seed",
    "backfill:korpus": "pnpm --filter @korrektur/backfill korpus",
    "backfill:review": "pnpm --filter @korrektur/backfill review",
    "bundle": "esbuild packages/api/src/web.ts packages/api/src/worker.ts --bundle --platform=node --format=cjs --target=node22 --outdir=build --out-extension:.js=.js && node -e \"const fs=require('node:fs'); fs.mkdirSync('build/tmp',{recursive:true}); fs.writeFileSync('build/package.json', JSON.stringify({type:'commonjs'})+'\\n')\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  }
}
