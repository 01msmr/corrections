# Vorlage. Kopieren nach .env.local (lokal) bzw. eintragen im
# Plesk-Node.js-Panel (Produktion). Keine echten Werte hier hinein.

# --- Grundlage ---------------------------------------------------------
PORT=3000
DATABASE_PATH=./data/korrektur.db
# Lokal der Quellpfad, auf dem Server ./migrations (Bündel-Layout).
MIGRATIONS_DIR=./packages/api/src/db/migrations
PUBLIC_BASE_URL=http://localhost:3000

# --- Anmeldung (Betreiber) ---------------------------------------------
ADMIN_USER=admin
# mindestens 8 Zeichen
ADMIN_PASSWORD=bitte-aendern

# --- Versand -----------------------------------------------------------
SMTP_HOST=mxe8db.netcup.net
SMTP_PORT=587
SMTP_USER=korrekturen@example.tld
SMTP_PASSWORD=bitte-aendern
MAIL_FROM=korrekturen@example.tld

# --- Postfach (Antwort-Zuordnung) --------------------------------------
# Ohne IMAP_HOST überspringt der Gang den Schritt sauber.
# In einer .env: Passwörter mit "#" in "…" setzen, sonst schneidet Nodes
# --env-file am # ab. In Plesk dagegen ohne Anführungszeichen.
IMAP_HOST=mxe8db.netcup.net
IMAP_PORT=993
IMAP_USER=korrekturen@example.tld
IMAP_PASSWORD=bitte-aendern
IMAP_TRASH=Trash

# --- Stündlicher Anstoß ------------------------------------------------
# Losungswort für /intern/posteingang?token=… ; ohne ihn ist die Route aus.
# Mindestens 16 Zeichen. /healthz zeigt, ob es angekommen ist.
WORKER_TOKEN=bitte-ein-langes-wort-ausdenken

# --- Rechtschreibprüfung ------------------------------------------------
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check
LANGUAGETOOL_SPRACHE=de-DE
